{
  "name": "bowling-tracker-cloud",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "test": "npm run test:unit && npm run test:browser && npm run test:rules",
    "test:unit": "node scripts/test.mjs unit",
    "test:browser": "node scripts/test.mjs browser",
    "test:performance": "node tests/performance.mjs",
    "test:rules": "firebase emulators:exec --only firestore --project demo-bowling-tracker \"node tests/security.rules.mjs\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "firebase": "12.17.1",
    "firebase-tools": "13.35.1",
    "playwright": "1.58.2"
  }
}
